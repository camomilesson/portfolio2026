---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HeroShowcase from '../components/HeroShowcase.astro';
const projects = (await getCollection('projects', ({data}) => data.featured)).sort((a,b) => a.data.order-b.data.order);
---
<Layout>
<section class="hero wrap">
  <div class="hero-topline"><p class="eyebrow"><span class="dot">■</span> Software Developer</p><p class="eyebrow hero-edition">Portfolio / 2026</p></div>
  <div class="hero-grid">
    <div class="hero-copy">
      <h1>Ideas are a start.<br /><span class="accent-text">I like to <br />build them.</span></h1>
      <p>I’m Andrei. I build web applications, mobile experiences, and AI-powered tools.</p>
      <a class="text-link" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
    </div>
    <HeroShowcase projects={projects} />
  </div>
</section>
<section id="work" class="work wrap"><div class="section-heading"><div><h2>A few things I’ve built<span class="count"> / {String(projects.length).padStart(2, '0')}</span></h2></div><a class="text-link" href="/projects/">All projects ↗</a></div><div class="project-grid">{projects.map((p,i) => <ProjectCard project={p} index={i} />)}</div></section>
<section id="about" class="about wrap"><p class="eyebrow">A little about me</p><div><h2>I like building things<br /><span class="accent-text">that I actually want to use.</span></h2><p>I’m a Computer Science student in Barcelona, building across web, mobile, games, and AI. Before software, I spent over a decade in journalism and editorial leadership—asking questions, making sense of complicated things, and getting work out the door.</p><p>I like taking projects past the “it works” stage: clear interfaces, saved progress, useful feedback, and the small details that make something worth coming back to.</p></div></section>
<section id="contact" class="contact wrap"><p class="eyebrow">Let’s connect</p><h2>Have something<br /><span class="accent-text">worth building?</span></h2><div class="contact-bottom"><p>Let’s talk about opportunities, projects, or something worth building.</p><div class="contact-links"><a class="text-link" href="/cv/Andrei_Romashkov_CV.pdf" download>Download CV (PDF) ↓</a><a class="text-link" href="mailto:camomilesson@gmail.com">Email me ↗</a><a class="text-link" href="https://www.linkedin.com/in/andrey-romashkov-38867bab/">LinkedIn ↗</a><a class="text-link" href="https://github.com/camomilesson">GitHub ↗</a></div></div></section></Layout>
