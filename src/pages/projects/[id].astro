---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import ProjectScreenshots from '../../components/ProjectScreenshots.astro';
import ProjectLogo from '../../components/ProjectLogo.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a,b) => a.data.order-b.data.order);
  return projects.map((project,i) => ({
    params: { id: project.id },
    props: { project, next: projects[(i+1)%projects.length] },
  }));
}
const {project,next} = Astro.props;
const {Content} = await render(project);
---
<Layout title={`${project.data.title} — Andrei Romashkov`} description={project.data.summary}>
  <article>
    <header class="case-header wrap">
      <a class="back-link" href="/projects/">← All projects</a>
      <p class="eyebrow">{project.data.category}</p>
      <div class="case-title">
        <ProjectLogo logo={project.data.logo} />
        <h1>{project.data.title}</h1>
      </div>
      <p class="case-summary">{project.data.summary}</p>
      <div class="case-links">
        <a class="text-link" href={project.data.source}>Source on GitHub ↗</a>
        {project.data.live && <a class="text-link" href={project.data.live}>{project.data.liveLabel} ↗</a>}
      </div>
    </header>
    <div class="wrap case-visual"><ProjectGallery project={project} /></div>
    <div class="case-body wrap">
      <aside>
        {project.data.role && <div class="project-credit"><p class="eyebrow">Role</p><p>{project.data.role}</p></div>}
        {project.data.context && <div class="project-credit"><p class="eyebrow">Context</p><p>{project.data.context}</p></div>}
        {project.data.team.length > 0 && <div class="project-credit"><p class="eyebrow">Team</p><ul class="team-credits">{project.data.team.map(member => <li><span>{member.name}{member.role && ` — ${member.role}`}</span>{(member.github || member.linkedin) && <span class="team-links">{member.github && <a href={member.github}>GitHub ↗</a>}{member.github && member.linkedin && ' · '}{member.linkedin && <a href={member.linkedin}>LinkedIn ↗</a>}</span>}</li>)}</ul></div>}
        <p class="eyebrow">Built with</p>
        <ul class="stack">{project.data.technologies.map(t => <li>{t}</li>)}</ul>
        {project.data.draft && <p class="draft-note">Project overview. Full case study to follow.</p>}
      </aside>
      <div class="prose"><Content /></div>
    </div>
    <ProjectScreenshots screenshots={project.data.screenshots} />
  </article>
  <div class="wrap next-project">
    <p class="eyebrow">Next project</p>
    <a href={`/projects/${next.id}/`}>{next.data.title} <span aria-hidden="true">↗</span></a>
  </div>
</Layout>
