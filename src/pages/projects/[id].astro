---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ProjectScreenshots from '../../components/ProjectScreenshots.astro';
export async function getStaticPaths() { const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order); return projects.map((project,i)=>({params:{id:project.id}, props:{project, next:projects[(i+1)%projects.length]}})); }
const {project,next} = Astro.props;
const {Content} = await render(project);
---
<Layout title={`${project.data.title} — Andrei Romashkov`} description={project.data.summary}><article><header class="case-header wrap"><a class="back-link" href="/projects/">← All projects</a><p class="eyebrow">{project.data.category}</p><h1>{project.data.title}</h1><p class="case-summary">{project.data.summary}</p><div class="case-links"><a class="text-link" href={project.data.source}>Source on GitHub ↗</a>{project.data.live && <a class="text-link" href={project.data.live}>{project.data.liveLabel} ↗</a>}</div></header><div class="wrap case-visual"><ProjectVisual project={project} /></div><div class="case-body wrap"><aside><p class="eyebrow">Built with</p><ul class="stack">{project.data.technologies.map(t=><li>{t}</li>)}</ul>{project.data.draft && <p class="draft-note">Project overview. Full case study to follow.</p>}</aside><div class="prose"><Content /></div></div><ProjectScreenshots screenshots={project.data.screenshots} /></article><div class="wrap next-project"><p class="eyebrow">Next project</p><a href={`/projects/${next.id}/`}>{next.data.title} <span aria-hidden="true">↗</span></a></div></Layout>
