---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Andrei Romashkov — Software Developer', description = 'I build web applications, mobile experiences, and AI-powered tools. Explore selected projects by Andrei Romashkov.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site!);
const socialImage = new URL('/social-card.png', Astro.site!);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#ffffff" />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap.xml" type="application/xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Andrei Romashkov" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Andrei Romashkov — Software Developer. Web, mobile, AI, and games." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header wrap"><a class="wordmark" href="/" aria-label="Andrei Romashkov, home">Andrei Romashkov<span class="dot">.</span></a><nav aria-label="Main navigation"><a href="/projects/" aria-current={Astro.url.pathname.startsWith('/projects') ? 'page' : undefined}>Work</a><a href="/#about">About</a><a href="/#contact">Contact <span aria-hidden="true">↗</span></a></nav></header>
<main id="main"><slot /></main>
<footer class="wrap footer"><span>© {new Date().getFullYear()} Andrei Romashkov</span><span>Built with care. And Astro.</span><nav class="footer-links" aria-label="Contact links"><a href="/cv/Andrei_Romashkov_CV.pdf" download>CV (PDF) ↓</a><a href="mailto:camomilesson@gmail.com">Email ↗</a><a href="https://www.linkedin.com/in/andrey-romashkov-38867bab/">LinkedIn ↗</a><a href="https://github.com/camomilesson">GitHub ↗</a></nav></footer>
</body></html>
