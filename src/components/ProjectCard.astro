---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
interface Props { project: CollectionEntry<'projects'>; index: number }
const {project, index} = Astro.props;
---
<article class="project-card"><a class="visual-link" href={`/projects/${project.id}/`} aria-label={`Read about ${project.data.title}`}><ProjectVisual project={project} /></a><div class="project-info"><span class="project-number">{String(index + 1).padStart(2, '0')}</span><div><p class="eyebrow">{project.data.category}</p><h3><a href={`/projects/${project.id}/`}>{project.data.title} <span aria-hidden="true">↗</span></a></h3><p class="summary">{project.data.summary}</p><ul class="tags" aria-label="Technologies">{project.data.technologies.map(t => <li>{t}</li>)}</ul></div></div></article>
